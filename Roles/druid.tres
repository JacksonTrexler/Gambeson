[sub_resource type="Resource" id="Choice_Biome"]
script = ExtResource("6_choice")
name = "Biome"
tabs = Array[ExtResource("5_tab")]([SubResource("Tab_astral"), SubResource("Tab_sylvan"), SubResource("Tab_montane"), SubResource("Tab_xeric"), SubResource("Tab_nival"), SubResource("Tab_thalassic")])
picks = 2

[sub_resource type="Resource" id="Choice_Guest"]
script = ExtResource("6_choice")
name = "Guest"
affinity = -1
spares_kin = true
borrows = Array[String](["School", "College"])

[resource]
script = ExtResource("1_script")
noun = "Caster"
name = "Druid"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike"), SubResource("Slot_beastshape")])
stats = Dictionary[StringName, int]({&"strength": 9, &"dexterity": 11, &"constitution": 12, &"intelligence": 11, &"wisdom": 15, &"charisma": 10})
items = Array[ExtResource("i_item")]([ExtResource("i_robe"), ExtResource("i_staff"), ExtResource("i_health_potion")])
general = Array[StringName]([&"magical"])
choices = Array[ExtResource("6_choice")]([SubResource("Choice_Biome"), SubResource("Choice_Guest")])
