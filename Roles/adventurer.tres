[resource]
script = ExtResource("1_script")
name = "Adventurer"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike"), SubResource("Slot_field_experience"), SubResource("Slot_working_knowledge"), SubResource("Slot_everyman")])
stats = Dictionary[StringName, int]({&"strength": 11, &"dexterity": 13, &"constitution": 11, &"intelligence": 10, &"wisdom": 12, &"charisma": 11})
center = ExtResource("s_skill_slot")
core = Array[ExtResource("5_skill")]([ExtResource("s_hex"), ExtResource("s_rejuvinate"), ExtResource("s_trade_skills"), ExtResource("s_grind")])
roots = Array[ExtResource("6_root")]([SubResource("Root_Magic"), SubResource("Root_Martial"), SubResource("Root_Specialist")])
