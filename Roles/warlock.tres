[sub_resource type="Resource" id="Branch_haluca"]
script = ExtResource("7_branch")
skill = ExtResource("s_haluca")
after = Array[ExtResource("5_skill")]([ExtResource("s_hex")])

[sub_resource type="Resource" id="Branch_level_down"]
script = ExtResource("7_branch")
skill = ExtResource("s_level_down")
needs = 4

[sub_resource type="Resource" id="Branch_death"]
script = ExtResource("7_branch")
skill = ExtResource("s_death")
