[sub_resource type="Resource" id="Slot_hex"]
script = ExtResource("4_slot")
skill = ExtResource("s_hex")

[sub_resource type="Resource" id="Slot_sweet_nothings"]
script = ExtResource("4_slot")
skill = ExtResource("s_sweet_nothings")

[sub_resource type="Resource" id="Branch_analysis_dialysis"]
script = ExtResource("7_branch")
skill = ExtResource("s_analysis_dialysis")
after = Array[ExtResource("5_skill")]([ExtResource("s_sweet_nothings")])

[sub_resource type="Resource" id="Branch_wauaw"]
script = ExtResource("7_branch")
skill = ExtResource("s_wauaw")
after = Array[ExtResource("5_skill")]([ExtResource("s_sweet_nothings")])

[sub_resource type="Resource" id="Branch_brainfog"]
script = ExtResource("7_branch")
skill = ExtResource("s_brainfog")
