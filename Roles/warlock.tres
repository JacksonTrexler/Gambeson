[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("4_slot")
skill = ExtResource("s_strike")

[sub_resource type="Resource" id="Slot_hex"]
script = ExtResource("4_slot")
skill = ExtResource("s_hex")

[sub_resource type="Resource" id="Slot_sweet_nothings"]
script = ExtResource("4_slot")
skill = ExtResource("s_sweet_nothings")

[sub_resource type="Resource" id="Choice_Patron"]
script = ExtResource("c_choice")
name = "Patron"
picks = 1
kinds = Array[String](["Patron"])
gods = true

[sub_resource type="Resource" id="Choice_Flex"]
script = ExtResource("c_choice")
name = "Flex"
picks = 2
kinds = Array[String](["Patron"])
gods = true
burns = true
after = ExtResource("opt_bargaining")

[resource]
script = ExtResource("1_script")
noun = "Caster"
name = "Warlock"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike"), SubResource("Slot_hex"), SubResource("Slot_sweet_nothings")])
stats = Dictionary[StringName, int]({&"strength": 8, &"dexterity": 12, &"constitution": 10, &"intelligence": 11, &"wisdom": 10, &"charisma": 15})
shared = Array[ExtResource("5_skill")]([ExtResource("s_hex"), ExtResource("s_sweet_nothings"), ExtResource("s_chant")])
items = Array[ExtResource("i_item")]([ExtResource("i_robe"), ExtResource("i_staff"), ExtResource("i_sweet_something")])
swaps = Dictionary[StringName, StringName]({&"wisdom": &"charisma"})
general = Array[StringName]([&"magical"])
choices = Array[ExtResource("c_choice")]([SubResource("Choice_Patron"), SubResource("Choice_Flex")])
options = Array[ExtResource("5_skill")]([ExtResource("opt_bargaining"), ExtResource("opt_acceptance")])
