[sub_resource type="Resource" id="Root_Elmon"]
script = ExtResource("6_root")
name = "Elmon"
tag = &"magical"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_analysis_dialysis"), SubResource("Branch_wauaw"), SubResource("Branch_brainfog"), SubResource("Branch_haluca"), SubResource("Branch_level_down"), SubResource("Branch_death")])

[sub_resource type="Resource" id="Tab_Elmon"]
script = ExtResource("8_tab")
name = "Elmon"
kind = "Patron"
devotes = true
roots = Array[ExtResource("6_root")]([SubResource("Root_Elmon")])

[sub_resource type="Resource" id="Branch_hogel_path"]
script = ExtResource("7_branch")
skill = ExtResource("s_hogel_path")
after = Array[ExtResource("5_skill")]([ExtResource("s_sweet_nothings")])

[sub_resource type="Resource" id="Root_Hogel"]
script = ExtResource("6_root")
name = "Hogel"
tag = &"magical"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_hogel_path")])

[sub_resource type="Resource" id="Tab_Hogel"]
script = ExtResource("8_tab")
name = "Hogel"
kind = "Patron"
devotes = true
roots = Array[ExtResource("6_root")]([SubResource("Root_Hogel")])

[resource]
script = ExtResource("1_script")
noun = "Caster"
name = "Warlock"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_hex"), SubResource("Slot_sweet_nothings")])
stats = Dictionary[StringName, int]({&"strength": 8, &"dexterity": 12, &"constitution": 10, &"intelligence": 11, &"wisdom": 10, &"charisma": 15})
tabs = Array[ExtResource("8_tab")]([SubResource("Tab_Elmon"), SubResource("Tab_Hogel")])
shared = Array[ExtResource("5_skill")]([ExtResource("s_hex"), ExtResource("s_sweet_nothings"), ExtResource("s_chant")])
items = Array[ExtResource("i_item")]([ExtResource("i_robe"), ExtResource("i_staff"), ExtResource("i_sweet_something")])
swaps = Dictionary[StringName, StringName]({&"wisdom": &"charisma"})
