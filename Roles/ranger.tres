[sub_resource type="Resource" id="Choice_Nature"]
script = ExtResource("6_choice")
name = "Nature"
by = ExtResource("s_wildcaller")
affinity = -1
invest = 4
talent = &"natural_talent"
borrows = Array[String](["Biome"])

[sub_resource type="Resource" id="Tab_survival"]
script = ExtResource("skilltab")
name = "Survival ??"
kind = "Path"
roots = Array[ExtResource("7_root")]([ExtResource("survival")])

[sub_resource type="Resource" id="Choice_survival"]
script = ExtResource("6_choice")
name = "Survival ??"
