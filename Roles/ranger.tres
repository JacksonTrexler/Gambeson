by = ExtResource("s_quarry")
affinity = -1

[resource]
script = ExtResource("1_script")
noun = "Scout"
name = "Ranger"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike")])
core = Array[ExtResource("5_skill")]([ExtResource("s_natural_talent")])
knack = Array[ExtResource("5_skill")]([ExtResource("s_discipline")])
stats = Dictionary[StringName, int]({&"strength": 11, &"dexterity": 14, &"constitution": 12, &"intelligence": 10, &"wisdom": 13, &"charisma": 9})
items = Array[ExtResource("i_item")]([ExtResource("i_gambeson"), ExtResource("i_rapier"), ExtResource("i_health_potion")])
general = Array[StringName]([&"specialist", &"martial"])
roots = Array[ExtResource("7_root")]([SubResource("Root_Bounty"), SubResource("Root_Scout"), SubResource("Root_Forester")])
choices = Array[ExtResource("6_choice")]([SubResource("Choice_prowess"), SubResource("Choice_survival"), SubResource("Choice_Nature")])
