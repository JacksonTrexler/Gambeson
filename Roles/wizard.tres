options = Array[ExtResource("7_skill")]([ExtResource("s_mana"), ExtResource("s_mage_armor"), ExtResource("s_darkstone"), ExtResource("s_sola"), ExtResource("s_nadira"), ExtResource("s_astera"), ExtResource("s_terestera"), ExtResource("s_hydera"), ExtResource("s_igna"), ExtResource("s_aetha")])
