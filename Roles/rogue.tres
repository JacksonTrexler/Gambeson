skill = ExtResource("s_wary")

[sub_resource type="Resource" id="Branch_stamina"]
script = ExtResource("7_branch")
skill = ExtResource("s_stamina")

[sub_resource type="Resource" id="Branch_jam"]
script = ExtResource("7_branch")
skill = ExtResource("s_jam")

[sub_resource type="Resource" id="Root_Blade"]
script = ExtResource("6_root")
name = "Blade"
tag = &"martial"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_wary"), SubResource("Branch_stamina"), SubResource("Branch_jam")])

[sub_resource type="Resource" id="Branch_meander"]
script = ExtResource("7_branch")
skill = ExtResource("s_meander")

[sub_resource type="Resource" id="Branch_clever_disguise"]
script = ExtResource("7_branch")
skill = ExtResource("s_clever_disguise")
after = Array[ExtResource("5_skill")]([ExtResource("s_meander")])

[sub_resource type="Resource" id="Branch_brood"]
script = ExtResource("7_branch")
skill = ExtResource("s_brood")
after = Array[ExtResource("5_skill")]([ExtResource("s_meander")])

[sub_resource type="Resource" id="Root_Shadow"]
script = ExtResource("6_root")
name = "Shadow"
tag = &"specialist"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_meander"), SubResource("Branch_clever_disguise"), SubResource("Branch_brood")])

[sub_resource type="Resource" id="Branch_snare"]
script = ExtResource("7_branch")
skill = ExtResource("s_snare")

[sub_resource type="Resource" id="Branch_hazard_expert"]
script = ExtResource("7_branch")
skill = ExtResource("s_hazard_expert")
after = Array[ExtResource("5_skill")]([ExtResource("s_snare")])

[sub_resource type="Resource" id="Root_Traps"]
script = ExtResource("6_root")
name = "Traps"
tag = &"specialist"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_snare"), SubResource("Branch_hazard_expert")])

[sub_resource type="Resource" id="Branch_observe"]
script = ExtResource("7_branch")
skill = ExtResource("s_observe")

[sub_resource type="Resource" id="Branch_eyes_forward"]
script = ExtResource("7_branch")
skill = ExtResource("s_eyes_forward")
after = Array[ExtResource("5_skill")]([ExtResource("s_observe")])

[sub_resource type="Resource" id="Branch_special_eyes"]
script = ExtResource("7_branch")
skill = ExtResource("s_special_eyes")
after = Array[ExtResource("5_skill")]([ExtResource("s_observe")])

[sub_resource type="Resource" id="Root_Eyes"]
script = ExtResource("6_root")
name = "Eyes"
tag = &"specialist"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_observe"), SubResource("Branch_eyes_forward"), SubResource("Branch_special_eyes")])

[sub_resource type="Resource" id="Tab_Freedom"]
script = ExtResource("8_tab")
name = "Freedom"
kind = "Calling"
center = ExtResource("s_hide")
core = Array[ExtResource("5_skill")]([ExtResource("s_move_plus_one"), ExtResource("s_darkvision"), ExtResource("s_self_evaluation"), ExtResource("s_first_aid")])
roots = Array[ExtResource("6_root")]([SubResource("Root_Shadow"), SubResource("Root_Traps"), SubResource("Root_Eyes")])

[resource]
script = ExtResource("1_script")
noun = "Tradefolk"
name = "Rogue"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike"), SubResource("Slot_move_plus_one")])
stats = Dictionary[StringName, int]({&"strength": 10, &"dexterity": 15, &"constitution": 10, &"intelligence": 11, &"wisdom": 12, &"charisma": 11})
roots = Array[ExtResource("6_root")]([SubResource("Root_Blade")])
tabs = Array[ExtResource("8_tab")]([SubResource("Tab_Freedom")])
items = Array[ExtResource("i_item")]([ExtResource("i_gambeson"), ExtResource("i_dagger"), ExtResource("i_energy_potion")])
general = Array[StringName]([&"specialist"])
