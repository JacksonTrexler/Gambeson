[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("4_slot")
skill = ExtResource("s_strike")

[sub_resource type="Resource" id="Slot_move_plus_one"]
script = ExtResource("4_slot")
skill = ExtResource("s_move_plus_one")

[sub_resource type="Resource" id="Branch_wary"]
