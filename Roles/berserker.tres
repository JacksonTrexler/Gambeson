[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("6_slot")
skill = ExtResource("4_strike")

[sub_resource type="Resource" id="Slot_reckless"]
script = ExtResource("6_slot")
skill = ExtResource("s_reckless_abandon")

[sub_resource type="Resource" id="Tab_Brawn"]
script = ExtResource("9_tab")
name = "Brawn"
kind = "Prowess"
roots = Array[ExtResource("7_root")]([ExtResource("r_brawn")])

[sub_resource type="Resource" id="Tab_Fury"]
script = ExtResource("9_tab")
name = "Fury"
kind = "Prowess"
roots = Array[ExtResource("7_root")]([ExtResource("r_fury")])

[sub_resource type="Resource" id="Tab_Havoc"]
script = ExtResource("9_tab")
name = "Havoc"
kind = "Prowess"
roots = Array[ExtResource("7_root")]([ExtResource("r_havoc")])

[resource]
script = ExtResource("1_script")
noun = "Brute"
name = "Berserker"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("6_slot")]([SubResource("Slot_strike"), SubResource("Slot_reckless")])
stats = Dictionary[StringName, int]({&"strength": 15, &"dexterity": 12, &"constitution": 15, &"intelligence": 8, &"wisdom": 9, &"charisma": 9})
items = Array[ExtResource("i_item")]([ExtResource("i_half_plate"), ExtResource("i_broadsword"), ExtResource("i_health_potion")])
general = Array[StringName]([&"martial"])
tabs = Array[ExtResource("9_tab")]([SubResource("Tab_Brawn"), SubResource("Tab_Fury"), SubResource("Tab_Havoc")])
