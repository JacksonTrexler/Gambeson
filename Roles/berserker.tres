[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("6_slot")
skill = ExtResource("4_strike")

[sub_resource type="Resource" id="Slot_reckless"]
script = ExtResource("6_slot")
skill = ExtResource("s_reckless_abandon")

[sub_resource type="Resource" id="B_bulwark"]
script = ExtResource("8_branch")
skill = ExtResource("s_bulwark")

[sub_resource type="Resource" id="B_crushing_blow"]
script = ExtResource("8_branch")
skill = ExtResource("s_crushing_blow")
after = Array[ExtResource("5_skill")]([ExtResource("s_bulwark")])

[sub_resource type="Resource" id="Root_Brawn"]
script = ExtResource("7_root")
name = "Brawn"
tag = &"martial"
branches = Array[ExtResource("8_branch")]([SubResource("B_bulwark"), SubResource("B_crushing_blow")])

[sub_resource type="Resource" id="Tab_Brawn"]
script = ExtResource("9_tab")
name = "Brawn"
kind = "Prowess"
roots = Array[ExtResource("7_root")]([SubResource("Root_Brawn")])

[sub_resource type="Resource" id="B_second_wind"]
script = ExtResource("8_branch")
skill = ExtResource("s_second_wind")

[sub_resource type="Resource" id="B_frenzy"]
script = ExtResource("8_branch")
skill = ExtResource("s_frenzy")
after = Array[ExtResource("5_skill")]([ExtResource("s_second_wind")])

[sub_resource type="Resource" id="Root_Fury"]
