name = "Havoc"
kind = "Prowess"
roots = Array[ExtResource("7_root")]([SubResource("Root_Havoc")])

[resource]
script = ExtResource("1_script")
noun = "Brute"
name = "Berserker"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("6_slot")]([SubResource("Slot_strike"), SubResource("Slot_reckless")])
stats = Dictionary[StringName, int]({&"strength": 15, &"dexterity": 12, &"constitution": 15, &"intelligence": 8, &"wisdom": 9, &"charisma": 9})
items = Array[ExtResource("i_item")]([ExtResource("i_half_plate"), ExtResource("i_broadsword"), ExtResource("i_health_potion")])
general = Array[StringName]([&"martial"])
tabs = Array[ExtResource("9_tab")]([SubResource("Tab_Brawn"), SubResource("Tab_Fury"), SubResource("Tab_Havoc")])
