[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("4_slot")
skill = ExtResource("s_strike")

[sub_resource type="Resource" id="Slot_pray"]
script = ExtResource("4_slot")
skill = ExtResource("s_pray")

[sub_resource type="Resource" id="Slot_renew"]
script = ExtResource("4_slot")
skill = ExtResource("s_renew")

[sub_resource type="Resource" id="Tab_Luun"]
script = ExtResource("8_tab")
name = "Luun"
kind = "Divinity"
roots = Array[ExtResource("6_root")]([ExtResource("r_luun")])
god = &"luun"
devotes = true

[sub_resource type="Resource" id="Tab_Sol"]
script = ExtResource("8_tab")
name = "Sol"
kind = "Divinity"
roots = Array[ExtResource("6_root")]([ExtResource("r_sol")])
god = &"sol"
devotes = true

[sub_resource type="Resource" id="Tab_Eros"]
script = ExtResource("8_tab")
name = "Eros"
kind = "Divinity"
roots = Array[ExtResource("6_root")]([ExtResource("r_eros")])
god = &"eros"
devotes = true

[sub_resource type="Resource" id="Choice_God"]
script = ExtResource("c_choice")
name = "God"
tabs = Array[ExtResource("8_tab")]([SubResource("Tab_Luun"), SubResource("Tab_Sol"), SubResource("Tab_Eros")])
picks = 1

[resource]
script = ExtResource("1_script")
noun = "Caster"
name = "Cleric"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("4_slot")]([SubResource("Slot_strike"), SubResource("Slot_pray"), SubResource("Slot_renew")])
stats = Dictionary[StringName, int]({&"strength": 10, &"dexterity": 10, &"constitution": 12, &"intelligence": 10, &"wisdom": 15, &"charisma": 12})
shared = Array[ExtResource("5_skill")]([ExtResource("s_pray"), ExtResource("s_renew")])
swaps = Dictionary[StringName, StringName]({&"charisma": &"wisdom", &"intelligence": &"wisdom"})
items = Array[ExtResource("i_item")]([ExtResource("i_robe"), ExtResource("i_staff"), ExtResource("i_energy_potion")])
general = Array[StringName]([&"magical"])
choices = Array[ExtResource("c_choice")]([SubResource("Choice_God")])
