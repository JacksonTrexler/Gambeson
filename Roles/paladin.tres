[ext_resource type="Resource" path="res://Items/broadsword.tres" id="i_broadsword"]
[ext_resource type="Resource" path="res://Items/health_potion.tres" id="i_health_potion"]
[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("6_slot")
skill = ExtResource("4_strike")

[resource]
script = ExtResource("1_script")
noun = "Soldier"
name = "Paladin"
god = &"eros"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("6_slot")]([SubResource("Slot_strike")])
stats = Dictionary[StringName, int]({&"strength": 12, &"dexterity": 10, &"constitution": 13, &"intelligence": 8, &"wisdom": 11, &"charisma": 13})
options = Array[ExtResource("20_skill")]([ExtResource("21_opt_favour"), ExtResource("22_opt_lightvision"), ExtResource("23_opt_renew"), ExtResource("24_opt_pray"), ExtResource("25_opt_coordinate"), ExtResource("26_opt_smite")])
items = Array[ExtResource("i_item")]([ExtResource("i_half_plate"), ExtResource("i_broadsword"), ExtResource("i_health_potion")])
general = Array[StringName]([&"martial", &"magical"])
