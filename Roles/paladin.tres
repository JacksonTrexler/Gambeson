[sub_resource type="Resource" id="Root_Divinity"]
script = ExtResource("6_root")
name = "Divinity: Eros"
tag = &"magical"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_rejuvinate"), SubResource("Branch_pray"), SubResource("Branch_renew"), SubResource("Branch_smite"), SubResource("Branch_send_off"), SubResource("Branch_lovely_caster"), SubResource("Branch_impassioned_fighter")])

