[resource]
script = ExtResource("1_script")
noun = "Soldier"
name = "Paladin"
god = &"eros"
look = ExtResource("2_sprite")
race = ExtResource("3_race")
innate = Array[ExtResource("6_slot")]([SubResource("Slot_strike")])
stats = Dictionary[StringName, int]({&"strength": 12, &"dexterity": 10, &"constitution": 13, &"intelligence": 8, &"wisdom": 11, &"charisma": 13})
options = Array[ExtResource("20_skill")]([ExtResource("21_opt_favour"), ExtResource("22_opt_lightvision"), ExtResource("s_judgement")])
roots = Array[ExtResource("6_root")]([SubResource("Root_Divinity"), SubResource("Root_Idealism")])
tabs = Array[ExtResource("t_tab")]([SubResource("Tab_protector"), SubResource("Tab_vanguard"), SubResource("Tab_brawn"), SubResource("Tab_fury"), SubResource("Tab_havoc"), SubResource("Tab_slayer")])
items = Array[ExtResource("i_item")]([ExtResource("i_half_plate"), ExtResource("i_broadsword"), ExtResource("i_health_potion")])
general = Array[StringName]([&"martial", &"magical"])
