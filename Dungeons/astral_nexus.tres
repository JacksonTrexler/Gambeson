[resource]
script = ExtResource("1_dungeon")
name = "Astral Nexus"
scene = "res://Scenes/astral_nexus_play.tscn"
blurb = "A few orange starpower generators, startiles in a broken grid around them, starpanes in most of the gaps and the astral void beyond."
goal = "Defeat every starman."
enemies = Array[PackedScene]([ExtResource("2_starman")])
rewards = Array[ExtResource("3_item")]([ExtResource("4_star")])
reward_floors = Array[float]([0.5])
color = Color(0.4, 0.75, 1, 1)
