[gd_resource type="Resource" script_class="Item" format=3]

[ext_resource type="Script" path="res://Scripts/Item.gd" id="1_item"]
[ext_resource type="Script" path="res://Scripts/Effect.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_tactics"]
script = ExtResource("2_effect")
stat = "tactics"
per_rank = true

[resource]
script = ExtResource("1_item")
