[gd_resource type="Resource" script_class="God" format=3]

[ext_resource type="Script" path="res://Scripts/God.gd" id="god"]
[ext_resource type="Script" path="res://Scripts/SkillTab.gd" id="tab"]
[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="rs"]
[ext_resource type="Resource" path="res://Gods/tabs/protector.tres" id="t_protector"]
[ext_resource type="Resource" path="res://Gods/tabs/vanguard.tres" id="t_vanguard"]
[ext_resource type="Resource" path="res://Trees/eros.tres" id="r_own"]

[sub_resource type="Resource" id="Tab_own"]
script = ExtResource("tab")
name = "Eros"
kind = "Divinity"
god = &"eros"
devotes = true
roots = Array[ExtResource("rs")]([ExtResource("r_own")])

[resource]
script = ExtResource("god")
id = &"eros"
domains = "love, healing"
tag = &"love"
own = SubResource("Tab_own")
pool = Array[ExtResource("tab")]([ExtResource("t_protector"), ExtResource("t_vanguard")])
