[ext_resource type="Script" path="res://Scripts/Behaviour.gd" id="4_behaviour"]
[ext_resource type="Script" path="res://Behaviours/theseus.gd" id="b_theseus"]

[sub_resource type="Resource" id="Behaviour_theseus"]
script = ExtResource("b_theseus")

[resource]
script = ExtResource("1_skill")
