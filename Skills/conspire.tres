[gd_resource type="Resource" script_class="Skill" format=3]

[ext_resource type="Script" path="res://Scripts/Skill.gd" id="1_script"]
[ext_resource type="Script" path="res://Scripts/Effect.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_conspire"]
script = ExtResource("2_effect")
stat = "conspire"
amount = 1.0
per_rank = true

[sub_resource type="Resource" id="Effect_ally_mitigate"]
script = ExtResource("2_effect")
stat = "ally_mitigate"
amount = 0.33
per_rank = true

[resource]
script = ExtResource("1_script")
name = "Conspire"
passive = true
toggle = true
tags = Array[StringName]([&"specialist", &"cha", &"defensive"])
effects = Array[ExtResource("2_effect")]([SubResource("Effect_conspire"), SubResource("Effect_ally_mitigate")])
