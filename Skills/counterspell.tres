script = ExtResource("1_skill")
name = "Counterspell"
ai = true
passive = true
tags = Array[StringName]([&"magical", &"defensive"])
stub = "Reactions (docs/todo/systems.md)"
plan = "When a foe in range casts a magical skill, spend 2 AP and Mana for a contest: the Mage's or Wizard's int + rank against the caster's stat. Winning, the spell fizzles and its cost is spent."
