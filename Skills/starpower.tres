[gd_resource type="Resource" script_class="Skill" format=3]

[ext_resource type="Script" path="res://Scripts/Skill.gd" id="1_skill"]
[ext_resource type="Script" path="res://Scripts/Effect.gd" id="2_effect"]

[sub_resource type="Resource" id="Effect_1"]
script = ExtResource("2_effect")
stat = "acts_as"
tags = Array[StringName]([&"mana", &"starpower"])

[sub_resource type="Resource" id="Effect_2"]
script = ExtResource("2_effect")
stat = "pool_max"
amount = 1.0
per_rank = true
tags = Array[StringName]([&"mana"])

[resource]
script = ExtResource("1_skill")
name = "Starpower"
passive = true
tags = Array[StringName]([&"magical", &"astral"])
effects = Array[ExtResource("2_effect")]([SubResource("Effect_1"), SubResource("Effect_2")])
max_rank = 5
