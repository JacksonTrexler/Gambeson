[gd_resource type="Resource" script_class="Skill" format=3]

[ext_resource type="Script" path="res://Scripts/Skill.gd" id="1_skill"]
[ext_resource type="Script" path="res://Scripts/Behaviour.gd" id="b_behaviour"]
[ext_resource type="Script" path="res://Behaviours/imbue.gd" id="b_imbue"]

[sub_resource type="Resource" id="Behaviour_imbue"]
script = ExtResource("b_imbue")
elements = Array[StringName]([&"fire", &"water", &"earth", &"air", &"light", &"dark"])

[resource]
script = ExtResource("1_skill")
name = "Elemental Strike"
tags = Array[StringName]([&"magical"])
exclusive = &"strike_form"
ap = 2.0
cost = 2
hostile = false
self_only = true
behaviours = Array[ExtResource("b_behaviour")]([SubResource("Behaviour_imbue")])
