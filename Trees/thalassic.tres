[gd_resource type="Resource" script_class="SkillRoot" format=3]

[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="root"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="branch"]
[ext_resource type="Script" path="res://Scripts/Skill.gd" id="skill"]
[ext_resource type="Resource" path="res://Skills/waterstrike.tres" id="s_waterstrike"]
[ext_resource type="Resource" path="res://Skills/oceanic.tres" id="s_oceanic"]
[ext_resource type="Resource" path="res://Skills/hydera.tres" id="s_hydera"]
[ext_resource type="Resource" path="res://Skills/undertow.tres" id="s_undertow"]
[ext_resource type="Resource" path="res://Skills/well_up.tres" id="s_well_up"]
[ext_resource type="Resource" path="res://Skills/maelstrom.tres" id="s_maelstrom"]

[sub_resource type="Resource" id="Branch_waterstrike"]
script = ExtResource("branch")
skill = ExtResource("s_waterstrike")

[sub_resource type="Resource" id="Branch_oceanic"]
script = ExtResource("branch")
skill = ExtResource("s_oceanic")
after = Array[ExtResource("skill")]([ExtResource("s_waterstrike")])

[sub_resource type="Resource" id="Branch_hydera"]
script = ExtResource("branch")
skill = ExtResource("s_hydera")
after = Array[ExtResource("skill")]([ExtResource("s_waterstrike")])

[sub_resource type="Resource" id="Branch_undertow"]
script = ExtResource("branch")
skill = ExtResource("s_undertow")
after = Array[ExtResource("skill")]([ExtResource("s_hydera")])

[sub_resource type="Resource" id="Branch_well_up"]
script = ExtResource("branch")
skill = ExtResource("s_well_up")
after = Array[ExtResource("skill")]([ExtResource("s_oceanic")])

[sub_resource type="Resource" id="Branch_maelstrom"]
script = ExtResource("branch")
skill = ExtResource("s_maelstrom")
after = Array[ExtResource("skill")]([ExtResource("s_undertow")])

[resource]
script = ExtResource("root")
name = "Thalassic"
tag = &"magical"
branches = Array[ExtResource("branch")]([SubResource("Branch_waterstrike"), SubResource("Branch_oceanic"), SubResource("Branch_hydera"), SubResource("Branch_undertow"), SubResource("Branch_well_up"), SubResource("Branch_maelstrom")])
