[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="2_root"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="3_branch"]
[ext_resource type="Script" path="res://Scripts/Skill.gd" id="4_skill"]
[ext_resource type="Resource" path="res://Skills/brutal_strike.tres" id="s_brutal_strike"]
[ext_resource type="Resource" path="res://Skills/strike_out.tres" id="s_strike_out"]
