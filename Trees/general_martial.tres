[sub_resource type="Resource" id="Root_main"]
script = ExtResource("2_root")
name = "Martial"
tag = &"martial"
branches = Array[ExtResource("3_branch")]([SubResource("Branch_brutal_strike"), SubResource("Branch_strike_out"), SubResource("Branch_agility_bracing"), SubResource("Branch_balanced_bracing"), SubResource("Branch_vanguard_bracing"), SubResource("Branch_combat_bracing"), SubResource("Branch_brutal_mastery")])

[resource]
script = ExtResource("1_tab")
name = "Martial"
kind = "General"
category = &"martial"
roots = Array[ExtResource("2_root")]([SubResource("Root_main")])
