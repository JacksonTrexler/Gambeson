[gd_resource type="Resource" script_class="SkillRoot" format=3]

[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="1_skillroot"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="2_branch"]
[ext_resource type="Resource" path="res://Skills/discipline.tres" id="s_discipline"]

[sub_resource type="Resource" id="Branch_discipline"]
script = ExtResource("2_branch")
skill = ExtResource("s_discipline")
tier = 3

[resource]
script = ExtResource("1_skillroot")
name = "Student"
tag = &"specialist"
branches = Array[ExtResource("2_branch")]([SubResource("Branch_discipline")])
