[gd_resource type="Resource" script_class="SkillRoot" format=3]

[ext_resource type="Script" path="res://Scripts/Skill.gd" id="5_skill"]
[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="6_root"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="7_branch"]
[ext_resource type="Resource" path="res://Skills/hex.tres" id="s_hex"]
[ext_resource type="Resource" path="res://Skills/sweet_nothings.tres" id="s_sweet_nothings"]
[ext_resource type="Resource" path="res://Skills/analysis_dialysis.tres" id="s_analysis_dialysis"]
[ext_resource type="Resource" path="res://Skills/wauaw.tres" id="s_wauaw"]
[ext_resource type="Resource" path="res://Skills/brainfog.tres" id="s_brainfog"]
