[resource]
script = ExtResource("6_root")
name = "Elmon"
tag = &"magical"
branches = Array[ExtResource("7_branch")]([SubResource("Branch_analysis_dialysis"), SubResource("Branch_wauaw"), SubResource("Branch_brainfog"), SubResource("Branch_haluca"), SubResource("Branch_level_down"), SubResource("Branch_death")])
