[ext_resource type="Resource" path="res://Skills/level_down.tres" id="s_level_down"]
[ext_resource type="Resource" path="res://Skills/death.tres" id="s_death"]

[sub_resource type="Resource" id="Branch_analysis_dialysis"]
script = ExtResource("7_branch")
skill = ExtResource("s_analysis_dialysis")
after = Array[ExtResource("5_skill")]([ExtResource("s_sweet_nothings")])

[sub_resource type="Resource" id="Branch_wauaw"]
script = ExtResource("7_branch")
skill = ExtResource("s_wauaw")
after = Array[ExtResource("5_skill")]([ExtResource("s_sweet_nothings")])

[sub_resource type="Resource" id="Branch_brainfog"]
script = ExtResource("7_branch")
skill = ExtResource("s_brainfog")
after = Array[ExtResource("5_skill")]([ExtResource("s_hex")])

[sub_resource type="Resource" id="Branch_haluca"]
script = ExtResource("7_branch")
skill = ExtResource("s_haluca")
after = Array[ExtResource("5_skill")]([ExtResource("s_hex")])

[sub_resource type="Resource" id="Branch_level_down"]
script = ExtResource("7_branch")
skill = ExtResource("s_level_down")
needs = 4

[sub_resource type="Resource" id="Branch_death"]
script = ExtResource("7_branch")
