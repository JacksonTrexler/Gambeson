[gd_resource type="Resource" script_class="SkillRoot" format=3]

[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="root"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="branch"]
[ext_resource type="Script" path="res://Scripts/Skill.gd" id="skill"]
[ext_resource type="Resource" path="res://Skills/rally.tres" id="s_rally"]
[ext_resource type="Resource" path="res://Skills/savage_swing.tres" id="s_savage_swing"]

[sub_resource type="Resource" id="Branch_rally"]
script = ExtResource("branch")
skill = ExtResource("s_rally")

[sub_resource type="Resource" id="Branch_savage_swing"]
script = ExtResource("branch")
skill = ExtResource("s_savage_swing")
after = Array[ExtResource("skill")]([ExtResource("s_rally")])

[resource]
script = ExtResource("root")
name = "Havoc"
tag = &"martial"
branches = Array[ExtResource("branch")]([SubResource("Branch_rally"), SubResource("Branch_savage_swing")])
gods = Array[StringName]([&"ramut", &"luun", &"drael", &"urlo"])
