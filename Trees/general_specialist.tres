[gd_resource type="Resource" script_class="SkillTab" format=3]

[ext_resource type="Script" path="res://Scripts/SkillTab.gd" id="1_tab"]
[ext_resource type="Script" path="res://Scripts/SkillRoot.gd" id="2_root"]
[ext_resource type="Script" path="res://Scripts/Branch.gd" id="3_branch"]
[ext_resource type="Script" path="res://Scripts/Skill.gd" id="4_skill"]
[ext_resource type="Resource" path="res://Skills/synergy.tres" id="s_synergy"]
[ext_resource type="Resource" path="res://Skills/decisive_strike.tres" id="s_decisive_strike"]
[ext_resource type="Resource" path="res://Skills/striking_features.tres" id="s_striking_features"]
[ext_resource type="Resource" path="res://Skills/agility_bracing.tres" id="s_agility_bracing"]
[ext_resource type="Resource" path="res://Skills/balanced_bracing.tres" id="s_balanced_bracing"]
[ext_resource type="Resource" path="res://Skills/decisive_mastery.tres" id="s_decisive_mastery"]

[sub_resource type="Resource" id="Branch_synergy"]
script = ExtResource("3_branch")
skill = ExtResource("s_synergy")
tier = 2

[sub_resource type="Resource" id="Branch_decisive_strike"]
script = ExtResource("3_branch")
skill = ExtResource("s_decisive_strike")
tier = 2

[sub_resource type="Resource" id="Branch_striking_features"]
script = ExtResource("3_branch")
skill = ExtResource("s_striking_features")
tier = 4

[sub_resource type="Resource" id="Branch_agility_bracing"]
script = ExtResource("3_branch")
skill = ExtResource("s_agility_bracing")
tier = 5

[sub_resource type="Resource" id="Branch_balanced_bracing"]
script = ExtResource("3_branch")
skill = ExtResource("s_balanced_bracing")
tier = 5

[sub_resource type="Resource" id="Branch_decisive_mastery"]
script = ExtResource("3_branch")
skill = ExtResource("s_decisive_mastery")
tier = 7

[sub_resource type="Resource" id="Root_main"]
script = ExtResource("2_root")
name = "Specialist"
tag = &"specialist"
branches = Array[ExtResource("3_branch")]([SubResource("Branch_synergy"), SubResource("Branch_decisive_strike"), SubResource("Branch_striking_features"), SubResource("Branch_agility_bracing"), SubResource("Branch_balanced_bracing"), SubResource("Branch_decisive_mastery")])

[resource]
script = ExtResource("1_tab")
name = "Specialist"
kind = "General"
category = &"specialist"
roots = Array[ExtResource("2_root")]([SubResource("Root_main")])
