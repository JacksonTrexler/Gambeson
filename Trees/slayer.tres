[sub_resource type="Resource" id="Branch_stamina"]
script = ExtResource("branch")
skill = ExtResource("s_stamina")

[resource]
script = ExtResource("root")
name = "Slayer"
tag = &"martial"
branches = Array[ExtResource("branch")]([SubResource("Branch_jugular"), SubResource("Branch_gank"), SubResource("Branch_spike"), SubResource("Branch_sutemi"), SubResource("Branch_poach"), SubResource("Branch_jam"), SubResource("Branch_slam_jam"), SubResource("Branch_peel"), SubResource("Branch_hitch"), SubResource("Branch_bludgeon"), SubResource("Branch_sundering"), SubResource("Branch_silent_strike"), SubResource("Branch_stamina")])
