[sub_resource type="Resource" id="Branch_jugular"]
script = ExtResource("branch")
skill = ExtResource("s_jugular")

[sub_resource type="Resource" id="Branch_gank"]
script = ExtResource("branch")
skill = ExtResource("s_gank")
after = Array[ExtResource("skill")]([ExtResource("s_jugular")])

[sub_resource type="Resource" id="Branch_spike"]
script = ExtResource("branch")
skill = ExtResource("s_spike")
after = Array[ExtResource("skill")]([ExtResource("s_jugular")])

[sub_resource type="Resource" id="Branch_sutemi"]
script = ExtResource("branch")
skill = ExtResource("s_sutemi")
after = Array[ExtResource("skill")]([ExtResource("s_jugular")])

[sub_resource type="Resource" id="Branch_poach"]
script = ExtResource("branch")
skill = ExtResource("s_poach")

[sub_resource type="Resource" id="Branch_jam"]
script = ExtResource("branch")
skill = ExtResource("s_jam")

[sub_resource type="Resource" id="Branch_slam_jam"]
script = ExtResource("branch")
skill = ExtResource("s_slam_jam")
after = Array[ExtResource("skill")]([ExtResource("s_jam")])

[sub_resource type="Resource" id="Branch_peel"]
