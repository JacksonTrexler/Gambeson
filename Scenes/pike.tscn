[sub_resource type="Resource" id="Bio_pike"]
script = ExtResource("6_bio")
behaviour = &"aggressive"
appearance = "Fish"
adjectives = Array[String](["Sleek"])
properties = Array[ExtResource("5_property")]([ExtResource("4_aquatic")])
text = "A long, lean ambush fish of reeds and still water: it lies in wait below and strikes up at whatever wades in. Its shape is the one a Thalassic Druid takes."

[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("8_slot")
skill = ExtResource("7_strike")
rank = 1

[node name="Pike" instance=ExtResource("1_unit")]
