[node name="HUD" type="CanvasLayer"]
script = ExtResource("1_hud")

[node name="Root" type="Control" parent="."]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
theme = ExtResource("2_theme")

[node name="Left" type="PanelContainer" parent="Root"]
layout_mode = 1
anchors_preset = 9
anchor_bottom = 1.0
offset_left = 3.0
offset_top = 3.0
offset_right = 77.0
offset_bottom = -3.0
grow_vertical = 2

[node name="Column" type="VBoxContainer" parent="Root/Left"]
layout_mode = 2
theme_override_constants/separation = 3

