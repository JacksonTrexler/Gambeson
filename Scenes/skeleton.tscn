[gd_scene format=3]

[ext_resource type="PackedScene" path="res://Scenes/unit.tscn" id="1_unit"]
[ext_resource type="Resource" path="res://Factions/unaligned.tres" id="2_unaligned"]
[ext_resource type="Texture2D" path="res://Units/Skeleton.png" id="3_skeleton"]
[ext_resource type="Script" path="res://Scripts/Bio.gd" id="4_bio"]
[ext_resource type="Resource" path="res://Skills/strike.tres" id="5_strike"]
[ext_resource type="Script" path="res://Scripts/Slot.gd" id="6_slot"]

[sub_resource type="Resource" id="Bio_skeleton"]
script = ExtResource("4_bio")
behaviour = &"aggressive"
appearance = "Skeleton"
text = "Bones that walk because someone willed them to: brittle, witless, and many."

[sub_resource type="Resource" id="Slot_strike"]
script = ExtResource("6_slot")
skill = ExtResource("5_strike")
rank = 1

[node name="Skeleton" instance=ExtResource("1_unit")]
faction = ExtResource("2_unaligned")
level = 1
look = ExtResource("3_skeleton")
tags = Array[StringName]([&"undead"])
vibe = "Hollow"
aura = -1
bio = SubResource("Bio_skeleton")
learned = Array[ExtResource("6_slot")]([SubResource("Slot_strike")])
max_hp = 6
max_energy = 4
strength = 10
dexterity = 10
constitution = 8
intelligence = 3
wisdom = 6
charisma = 2
